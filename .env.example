# Literal KEY=value. Quoted values are supported; never commit your .env.
WLK_WS_URL=ws://localhost:8000/asr
CAPTIONS_LANGUAGE=es
CAPTIONS_LOG_RAW=0
CAPTIONS_CONNECT_TIMEOUT=15
CAPTIONS_STOP_TIMEOUT=120

# First start without billable calls. Fill key locally, then enable explicitly.
TRANSLATION_ENABLED=0
TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=""
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
TRANSLATION_SOURCE_LANGUAGE=es
TRANSLATION_TARGET_LANGUAGE=en
TRANSLATION_CONTEXT_SEGMENTS=2
TRANSLATION_TIMEOUT_SECONDS=8
TRANSLATION_RETRIES=1
TRANSLATION_QUEUE_MAXSIZE=32

# Baseline A: preserve these values for the v0.1 release validation.
SEGMENT_STABILIZATION_SECONDS=0.8
SEGMENT_SILENCE_SECONDS=1.0
SEGMENT_MINIMUM_WORDS=7
SEGMENT_TARGET_WORDS=13
SEGMENT_MAX_WORDS=21
SEGMENT_SAFE_CUT_LOOKBACK_WORDS=8
SEGMENT_SOFT_MAX_AGE_SECONDS=3.3
SEGMENT_HARD_MAX_AGE_SECONDS=5.5
SEGMENT_TICK_SECONDS=0.1

# Transparent overlay over the blue band created in OBS.
CAPTION_MODE=persistent_rolling
CAPTION_CANVAS_WIDTH=1920
CAPTION_CANVAS_HEIGHT=1080
CAPTION_REGION_X=0
CAPTION_REGION_Y=930
CAPTION_REGION_WIDTH=1920
CAPTION_REGION_HEIGHT=150
CAPTION_PADDING_X=32
CAPTION_PADDING_Y=8
CAPTION_FONT_SIZE=48
CAPTION_LINE_HEIGHT=1.2
CAPTION_MAX_LINES=3
CAPTION_MAX_WIDTH=1500
CAPTION_POSITION=center
CAPTION_BACKGROUND_OPACITY=0
CAPTION_STOP_CLEAR_MS=8000
